# URL of the REZA Express API, including /api. Server side only (never exposed
# to the browser: the dashboard calls the API through the /api/backend proxy).
# Production: https://<backend-host>/api
BACKEND_API_URL=http://127.0.0.1:5000/api

# Same value as BFF_SHARED_SECRET in the backend .env. Lets the backend rate
# limit login attempts per browser IP instead of per web server IP.
BFF_SHARED_SECRET=

# Public address of the site (link previews, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public client site (landing_client): old /client links redirect there
NEXT_PUBLIC_CLIENT_URL=http://localhost:3100
